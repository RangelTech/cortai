# Exemplo de ambiente do cortai. SÓ NOMES: os valores ficam no Infisical (rt-produtos/cortai, ambiente prod) e chegam à VPS no deploy. Nunca commitar valores.
# Em desenvolvimento local basta copiar para .env e preencher o que for usar; sem SMTP/LLM o app roda em modo de desenvolvimento.

CORTAI_ADMIN_KEY=
CORTAI_CAKTO_SEGREDO=
CORTAI_CHECKOUT_MENSAL=
CORTAI_DEMO_SENHA=
CORTAI_LLM_KEY=
CORTAI_PROXY=
CORTAI_SEGREDO_SESSAO=
CORTAI_SMTP_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
